{
    "name": "server",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "migration": "npx prisma migrate deploy",
        "start:prod": "node dist/apps/server/src/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json --testTimeout=1000000000"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.735.0",
        "@aws-sdk/client-s3-control": "^3.734.0",
        "@nestjs-modules/mailer": "^2.0.2",
        "@nestjs/bullmq": "^11.0.1",
        "@nestjs/common": "^11.0.5",
        "@nestjs/config": "^4.0.0",
        "@nestjs/core": "^11.0.5",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/mapped-types": "^2.1.0",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.0.5",
        "@nestjs/schedule": "^5.0.1",
        "@prisma/client": "6.2.1",
        "bcrypt": "^5.1.1",
        "bullmq": "^5.37.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "cookie-parser": "^1.4.7",
        "date-fns": "^4.1.0",
        "ejs": "^3.1.10",
        "nestjs-form-data": "^1.9.92",
        "nestjs-mapped-types": "^3.0.5",
        "nodemailer": "^6.10.0",
        "passport": "^0.7.0",
        "passport-google-oauth2": "^0.2.0",
        "passport-google-oauth20": "^2.0.0",
        "passport-jwt": "^4.0.1",
        "passport-local": "^1.0.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "schema": "workspace:*",
        "uuid": "^11.0.5"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.2",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.5",
        "@testcontainers/postgresql": "^10.17.1",
        "@testcontainers/redis": "^10.17.1",
        "@types/bcrypt": "^5.0.2",
        "@types/cookie-parser": "^1.4.8",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/multer": "^1.4.12",
        "@types/node": "^22.10.10",
        "@types/nodemailer": "^6.4.17",
        "@types/passport-google-oauth20": "^2.0.16",
        "@types/passport-jwt": "^4.0.1",
        "@types/passport-local": "^1.0.38",
        "@types/supertest": "^6.0.2",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^8.21.0",
        "@typescript-eslint/parser": "^8.21.0",
        "eslint": "^9.19.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.3",
        "jest": "^29.7.0",
        "jest-junit": "^16.0.0",
        "mailhog": "^4.16.0",
        "prettier": "^3.4.2",
        "prisma": "^6.2.1",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "testcontainers": "^10.17.1",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3"
    },
    "jest": {
        "preset": "ts-jest",
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "moduleNameMapper": {
            "^@server/(.*)$": "<rootDir>/$1"
        }
    }
}
